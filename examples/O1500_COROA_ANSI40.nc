%
O1500 (COROA CORRENTE ANSI 40 - ROMI GL EIXO C);
(ZERO PECA: X0 = CENTRO / Z0 = FACE / C0 = PRIMEIRO VAO);
(T01 = FRESA 8MM AXIAL - ALIVIO / T02 = FRESA 6MM AXIAL - PERFIL);
(T02: CORRETOR COM R=3.0 E T=0 PARA O G41);
(=========== ALTERAR AQUI ===========);
#100=15      (NUMERO DE DENTES);
#103=7.7     (PROFUNDIDADE TOTAL DE CORTE);
#104=2.0     (PROFUNDIDADE POR PASSE);
(====================================);
(--- CONSTANTES CORRENTE ANSI 40 - 1/2POL ---);
#101=12.7    (PASSO);
#102=7.9248  (DIAMETRO DO ROLO);
#105=0.5     (FURO 8MM DESLOCADO P/ FORA DO PRIMITIVO);
#107=2.      (APROXIMACAO EM Z);
#110=60.     (AVANCO FURO 8MM MM/MIN);
#111=250.    (AVANCO PERFIL 6MM MM/MIN);
#112=150.    (AVANCO ENTRADA Z 6MM);
#113=3000.   (AVANCO POSICIONAMENTO DENTRO DO G12.1);
IF [#100 LT 9] THEN #3000=1 (MINIMO 9 DENTES);
(--- GEOMETRIA ANSI B29.1 - VAO EM C0 - X EM RAIO, C EM MM ---);
#120=180/#100                         (MEIO PASSO ANGULAR);
#121=#101/[2*SIN[#120]]               (RAIO PRIMITIVO);
#122=[1.005*#102+0.003]/2             (RAIO ASSENTO);
#123=35+60/#100                       (ANGULO A);
#124=18-56/#100                       (ANGULO B);
#125=1.3025*#102+0.0015               (RAIO E - FLANCO);
#126=#102*[0.8*COS[#124]+1.4*COS[17-64/#100]-1.3025]-0.0015 (RAIO F - TOPO);
#127=#101*[0.6+COS[#120]/SIN[#120]]/2 (RAIO EXTERNO);
#130=#121+0.8*#102*SIN[#123]          (CENTRO E X);
#131=0.8*#102*COS[#123]               (CENTRO E C);
#132=#121-1.4*#102*SIN[#120]          (CENTRO F X);
#133=1.4*#102*COS[#120]               (CENTRO F C);
#134=#121-#122*SIN[#123]              (P1 X - ASSENTO/E);
#135=#122*COS[#123]                   (P1 C);
#136=#130-#125*SIN[#123-#124]         (P2 X - E/RETA);
#137=#125*COS[#123-#124]-#131         (P2 C);
#138=#132+#126*SIN[#123-#124]         (P3 X - RETA/F);
#139=#133-#126*COS[#123-#124]         (P3 C);
#140=SQRT[#132*#132+#133*#133];
#141=[#127*#127-#126*#126+#140*#140]/[2*#140];
#142=SQRT[#127*#127-#141*#141];
#143=[#141*#132+#142*#133]/#140       (P4 X - F/DIAM EXTERNO);
#144=[#141*#133-#142*#132]/#140       (P4 C);
#146=#143*[1+10/#127]                 (ENTRADA X - 10MM FORA);
#147=#144*[1+10/#127]                 (ENTRADA C);
#148=2*[#121+#105]                    (DIAMETRO X DO FURO 8MM);
G21 G40 G90 G95;
(=========== T01 - FRESA 8MM - FURO DE ALIVIO ===========);
G53 X0 Z0;
T0101 (FRESA 8MM);
G97 S2=1200 M3 (FERRAMENTA ACIONADA);
M19 (ATIVA EIXO C);
G28 C0;
G94;
G0 X#148 Z#107 C0;
#150=0;
WHILE [#150 LT #100] DO1;
G0 C[#150*360/#100];
M85 (FREIO - G0 C CANCELA);
#156=0;
WHILE [#156 GT -#103] DO2;
G0 Z[#156+0.5];
#156=#156-#104;
IF [#156 LT -#103] THEN #156=-#103;
G1 Z#156 F#110;
G0 Z#107;
END2;
#150=#150+1;
END1;
M5 (DESLIGA FERRAMENTA E FREIO);
G53 X0 Z0;
(=========== T02 - FRESA 6MM - PERFIL DO DENTE ===========);
T0202 (FRESA 6MM);
G97 S2=2000 M3;
G94;
G0 C0;
G0 X[2*#146] Z#107;
G12.1;
#150=0;
WHILE [#150 LT #100] DO1;
#151=#150*360/#100;
#160=COS[#151];
#161=SIN[#151];
(PONTOS GIRADOS - X EM DIAMETRO / C EM MM);
#170=2*[#146*#160-#147*#161]          (ENTRADA X);
#171=#146*#161+#147*#160              (ENTRADA C);
#172=2*[#143*#160-#144*#161]          (P4 SUP);
#173=#143*#161+#144*#160;
#174=2*[#138*#160-#139*#161]          (P3 SUP);
#175=#138*#161+#139*#160;
#176=2*[#136*#160-#137*#161]          (P2 SUP);
#177=#136*#161+#137*#160;
#178=2*[#134*#160-#135*#161]          (P1 SUP);
#179=#134*#161+#135*#160;
#180=2*[#134*#160+#135*#161]          (P1 INF);
#181=#134*#161-#135*#160;
#182=2*[#136*#160+#137*#161]          (P2 INF);
#183=#136*#161-#137*#160;
#184=2*[#138*#160+#139*#161]          (P3 INF);
#185=#138*#161-#139*#160;
#186=2*[#143*#160+#144*#161]          (P4 INF);
#187=#143*#161-#144*#160;
#188=2*[#146*#160+#147*#161]          (SAIDA X);
#189=#146*#161-#147*#160              (SAIDA C);
#152=0;
WHILE [#152 GT -#103] DO2;
#152=#152-#104;
IF [#152 LT -#103] THEN #152=-#103;
G1 X#170 C#171 F#113;
G1 Z#152 F#112;
G41 G1 X#172 C#173 F#111;
G2 X#174 C#175 R#126;
G1 X#176 C#177;
G3 X#178 C#179 R#125;
G3 X#180 C#181 R#122;
G3 X#182 C#183 R#125;
G1 X#184 C#185;
G2 X#186 C#187 R#126;
G40 G1 X#188 C#189;
G1 Z#107 F#113;
END2;
#150=#150+1;
END1;
G13.1;
M5;
G53 X0 Z0;
M30;
%
