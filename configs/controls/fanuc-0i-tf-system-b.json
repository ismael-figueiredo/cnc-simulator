    "M04": { "function": "spindle-ccw" },
    "M05": { "function": "spindle-stop", "description": { "en": "Also releases the M85 brake", "pt-BR": "Também cancela o freio M85", "es": "También libera el freno M85" } },
    "M08": { "function": "coolant-on" },
    "M09": { "function": "coolant-off" },
    "M15": { "function": "other", "description": { "en": "Reverse coupling shaft rotation (counter-clockwise)", "pt-BR": "Inverte o eixo de acoplamento (anti-horário)", "es": "Invierte el eje de acoplamiento (antihorario)" } },
    "M16": { "function": "other", "description": { "en": "Reverse coupling shaft rotation (clockwise)", "pt-BR": "Inverte o eixo de acoplamento (horário)", "es": "Invierte el eje de acoplamiento (horario)" } },
    "M19": { "function": "c-axis-on", "description": { "en": "Spindle orientation / enable C axis", "pt-BR": "Orienta o eixo-árvore / ativa o eixo C", "es": "Orienta el husillo / activa el eje C" } },
    "M30": { "function": "end-rewind" },
    "M85": { "function": "brake-on", "description": { "en": "High-torque brake; G0 C or M5 release it", "pt-BR": "Freio de alto torque; G0 C ou M5 cancelam", "es": "Freno de alto par; G0 C o M5 lo liberan" } },
    "M98": { "function": "subprogram-call" },
    "M99": { "function": "subprogram-return" }
