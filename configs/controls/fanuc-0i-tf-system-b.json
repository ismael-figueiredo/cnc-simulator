  "rules": [
    "no-g0-in-polar",
    "no-brake-in-polar",
    "c-axis-requires-enable",
    "cutter-comp-start-linear",
    "live-tool-on-while-cutting"
  ],
  "alarms": "fanuc-0i",
  "fileFormat": {
    "startPercent": true,
    "endPercent": true,
    "eob": "semicolon",
    "missingEob": "alarm",
    "programNumber": "required",
    "requireDecimalPoint": false
  },
  "limits": {
    "maxDigits": 8,
    "maxValue": 99999.999,
    "subprogramNesting": 4,
    "macroNesting": 4,
    "bracketNesting": 5,
    "loopIds": 3,
    "maxSequenceNumber": 99999,
    "maxProgramNumber": 9999,
    "compNoMoveBlocks": 1,
    "arcTolerance": 0.02,
    "toolOffsets": 64
  }
}
