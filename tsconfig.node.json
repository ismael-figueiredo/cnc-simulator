{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022"],
    "types": ["node", "electron-vite/node"]
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.mts",
    "scripts/site.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/server/**/*",
    "src/core/**/*",
    "src/i18n/**/*",
    "src/renderer/playback.ts",
    "src/renderer/help.ts",
    "src/renderer/views.ts",
    "src/renderer/editing.ts",
    "src/renderer/geometry/**/*",
    "src/renderer/collisions.ts",
    "src/renderer/documentStart.ts",
    "src/renderer/messages.ts",
    "src/renderer/project.ts",
    "src/renderer/simulationInput.ts",
    "src/renderer/types.ts",
    "src/renderer/platform/browser.ts",
    "src/renderer/platform/electron.ts",
    "src/renderer/platform/storage.ts",
    "src/renderer/platform/types.ts",
    "tests/**/*.ts"
  ]
}
