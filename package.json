{
  "name": "cnc-simulator",
  "productName": "CNC Simulator",
  "version": "0.18.1",
  "private": true,
  "description": "Free, open-source CNC simulator to learn and test G-code: lathes and machining centers, Fanuc, Mitsubishi and Haas controls, Macro B, alarms and collision checks.",
  "main": "./out/main/main.js",
  "author": {
    "name": "Ismael Figueiredo",
    "email": "maelio@live.com"
  },
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run check && electron-vite build",
    "build:only": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "server": "tsx src/server/server.ts",
    "dist:win": "npm run build && electron-builder --win",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "icons": "electron scripts/icons.mjs",
    "demo": "electron-vite build && electron scripts/demo.mjs",
    "screens": "electron-vite build && electron scripts/screens.mjs",
    "site": "tsx scripts/site.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fastify/static": "^10.1.7",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "electron-updater": "^6.8.9",
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gifenc": "^1.0.3",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
